# Copy to .env and fill in. .env is git-ignored — never commit it.

# development | production
ENV=production

# Full public URL, no trailing slash. Always set this on production:
# without it the site trusts the request's Host header.
SITE_URL=https://example.com
# Optional, used only when SITE_URL is empty: comma-separated hosts to accept.
ALLOWED_HOSTS=

SITE_NAME=LUMEEGY

# Database
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paymob (can also be set in Admin → Settings → Payment)
GATEWAY_API_KEY=
GATEWAY_IFRAME_ID=
GATEWAY_HMAC_SECRET=

# Meta Pixel / Conversions API
META_PIXEL_ID=
META_CONVERSION_API_TOKEN=
