# Uploaded files live under assets/ — never execute scripts from here.
<FilesMatch "\.(php\d?|phtml|phar|pht|cgi|pl|py|sh)$">
Require all denied
</FilesMatch>

# SVG files can contain scripts; never let them run when opened directly.
<IfModule mod_headers.c>
<FilesMatch "\.svg$">
Header set Content-Security-Policy "script-src 'none'; object-src 'none'"
</FilesMatch>
</IfModule>
